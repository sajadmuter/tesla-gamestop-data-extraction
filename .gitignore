~$*
*.tmp
*.log
.DS_Store
Thumbs.db

# Editor-local settings
.idea/
.vscode/

# Deliberately do NOT ignore all CSV, XLSX, PBIX, PNG or PDF files.
# Approved synthetic datasets and portfolio outputs should be publishable.
# Gitignore does not remove files that Git already tracks or historical secrets.
